# Build number increments once per complete three-kernel kit.
# A direct single-variant build uses the default number unless overridden.
# Set KBUILD_BUILD_TIMESTAMP to a fixed UTC string for reproducible builds.
export KBUILD_BUILD_USER="${KBUILD_BUILD_USER:-perezchilli}"
export KBUILD_BUILD_HOST="${KBUILD_BUILD_HOST:-build-host}"
export KBUILD_BUILD_VERSION="${KBUILD_BUILD_VERSION:-21}"
export KBUILD_BUILD_TIMESTAMP="${KBUILD_BUILD_TIMESTAMP:-$(LC_ALL=C date -u '+%a %b %-d %T UTC %Y')}"
